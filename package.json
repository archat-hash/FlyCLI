{
  "name": "flycli",
  "version": "1.0.0",
  "description": "A reliable CLI tool for Betaflight flight controller interaction and automation.",
  "license": "MIT",
  "keywords": [
    "betaflight",
    "cli",
    "drone",
    "fpv",
    "flight-controller",
    "serialport",
    "automation"
  ],
  "author": "Oleh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archat-hash/FlyCLI.git"
  },
  "bugs": {
    "url": "https://github.com/archat-hash/FlyCLI/issues"
  },
  "homepage": "https://github.com/archat-hash/FlyCLI#readme",
  "type": "module",
  "main": "launcher.cjs",
  "bin": {
    "flycli": "./index.js"
  },
  "files": [
    "src/",
    "index.js",
    "README.md",
    "docs/",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:bdd": "node --experimental-vm-modules node_modules/.bin/cucumber-js",
    "test:hw": "node --experimental-vm-modules node_modules/.bin/cucumber-js --profile hw",
    "test:full": "npm run test && npm run test:bdd && npm run test:hw",
    "pretest": "npm run lint",
    "lint": "eslint .",
    "prepare": "npm run lint",
    "build:bin": "esbuild index.js --bundle --platform=node --format=cjs --outfile=bundle/flycli.cjs --external:serialport --external:commander && node scripts/build-bin.js"
  },
  "pkg": {
    "assets": [
      "src/**/*",
      "docs/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64",
      "node18-macos-x64"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "esbuild": "^0.28.0",
    "fs-extra": "^11.3.5",
    "pkg": "^5.8.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.7.0",
    "@jest/globals": "^30.3.0",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0"
  }
}
